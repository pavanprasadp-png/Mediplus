CREATE DATABASE hospital_db;
USE hospital_db;

CREATE TABLE patients(
  patient_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(50) NOT NULL,
  age INT, gender VARCHAR(10),
  phone VARCHAR(15), disease VARCHAR(50)
);

CREATE TABLE doctors(
  doctor_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(50) NOT NULL,
  specialization VARCHAR(50),
  phone VARCHAR(15), fee DOUBLE
);

CREATE TABLE appointments(
  appt_id INT AUTO_INCREMENT PRIMARY KEY,
  patient_id INT, doctor_id INT,
  appt_date DATE, status VARCHAR(15) DEFAULT 'BOOKED',
  FOREIGN KEY (patient_id) REFERENCES patients(patient_id),
  FOREIGN KEY (doctor_id) REFERENCES doctors(doctor_id)
);

CREATE TABLE bills(
  bill_id INT AUTO_INCREMENT PRIMARY KEY,
  appt_id INT, amount DOUBLE, bill_date DATE,
  FOREIGN KEY (appt_id) REFERENCES appointments(appt_id)
);
